{
  "name": "customer-rsbuild",
  "private": true,
  "version": "0.0.0",
  "description": "A project that injects its own components into @acme/core with stunt-double (Rsbuild 2).",
  "type": "module",
  "scripts": {
    "postinstall": "stunt-double gen --no-fail",
    "dev": "rsbuild dev",
    "build": "rsbuild build",
    "preview": "rsbuild preview",
    "typecheck": "tsc -p tsconfig.json",
    "check": "stunt-double check",
    "probe": "node probes/render.mjs dist-ssr/entry-server.mjs"
  },
  "dependencies": {
    "@acme/core": "file:../../.packs/acme-core-1.0.0.tgz",
    "@acme/core-slots": "file:./sdk-slots",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@rsbuild/core": "2.2.12",
    "@rsbuild/plugin-react": "2.1.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "stunt-double": "file:../../.packs/stunt-double-0.1.0.tgz",
    "typescript": "7.0.2"
  }
}
