{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,

    /* stunt-double: types follow the generated shims, even inside node_modules/@acme/core */
    "paths": { "@acme/core-slots/*": ["./sdk-slots/gen/*"] }
  },
  "include": ["src"],
  /* stunt-double: a missing generated check file is TS6053, never "silently unchecked" */
  "files": ["src/stunt-double.check.ts"]
}
