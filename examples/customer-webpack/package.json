{
  "name": "customer-webpack",
  "private": true,
  "version": "0.0.0",
  "description": "A project that injects its own components and services into @acme/core with stunt-double (webpack 5 + Babel 8).",
  "type": "module",
  "scripts": {
    "build": "webpack --mode production",
    "dev": "webpack --mode development --watch",
    "typecheck": "tsc --noEmit",
    "probe": "node probes/render.mjs"
  },
  "dependencies": {
    "@acme/core": "file:../../.packs/acme-core-1.0.0.tgz",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@babel/core": "8.0.7",
    "@babel/preset-react": "8.0.1",
    "@babel/preset-typescript": "8.0.7",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "babel-loader": "10.1.1",
    "stunt-double": "file:../../.packs/stunt-double-0.1.0.tgz",
    "typescript": "7.0.2",
    "webpack": "5.111.1",
    "webpack-cli": "7.2.3"
  },
  "overrides": {
    "@acme/core-slots": "file:../../.packs/acme-core-slots-0.0.1.tgz"
  }
}
