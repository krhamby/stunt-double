{
  "name": "customer-webpack",
  "private": true,
  "version": "0.0.0",
  "description": "A project that injects its own components into @acme/core with stunt-double (webpack 5 + webpack-dev-server).",
  "type": "module",
  "scripts": {
    "dev": "webpack serve --mode development",
    "build": "webpack --mode production",
    "typecheck": "tsc -p tsconfig.json",
    "probe": "node probes/render.mjs dist-ssr/entry-server.mjs"
  },
  "dependencies": {
    "@acme/core": "file:../../.packs/acme-core-1.0.0.tgz",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@swc/core": "1.16.13",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "html-webpack-plugin": "5.6.8",
    "stunt-double": "file:../../.packs/stunt-double-0.1.0.tgz",
    "swc-loader": "0.2.7",
    "typescript": "7.0.2",
    "webpack": "5.111.1",
    "webpack-cli": "7.2.3",
    "webpack-dev-server": "6.0.0"
  },
  "overrides": {
    "@acme/core-slots": "file:../../.packs/acme-core-slots-0.0.1.tgz"
  }
}
