{
  "name": "customer-next",
  "private": true,
  "version": "0.0.0",
  "description": "A project that injects its own components into @acme/core with stunt-double (Next.js 16: App Router + Server Components, Pages Router, Turbopack and --webpack).",
  "type": "module",
  "scripts": {
    "postinstall": "stunt-double gen --no-fail",
    "dev": "stunt-double watch -- next dev",
    "dev:webpack": "stunt-double watch -- next dev --webpack",
    "build": "next build",
    "build:webpack": "next build --webpack",
    "start": "next start",
    "check": "stunt-double check"
  },
  "dependencies": {
    "@acme/core": "file:../../.packs/acme-core-1.0.0.tgz",
    "@acme/core-slots": "file:./sdk-slots",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "stunt-double": "file:../../.packs/stunt-double-0.1.0.tgz",
    "typescript": "7.0.2"
  }
}
