{
  "name": "customer-esbuild",
  "private": true,
  "version": "0.0.0",
  "description": "A project that injects its own components and services into @acme/core with stunt-double (esbuild 0.28, JS API).",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "probe": "node probes/render.mjs"
  },
  "dependencies": {
    "@acme/core": "file:../../.packs/acme-core-1.0.0.tgz",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "stunt-double": "file:../../.packs/stunt-double-0.1.0.tgz",
    "typescript": "7.0.2"
  },
  "overrides": {
    "@acme/core-slots": "file:../../.packs/acme-core-slots-0.0.1.tgz"
  }
}
