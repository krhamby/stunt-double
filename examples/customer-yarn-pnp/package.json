{
  "name": "customer-yarn-pnp",
  "private": true,
  "version": "0.0.0",
  "description": "customer-vite installed with Yarn 4 Plug'n'Play: no node_modules, packages in zip archives, strict dependencies.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "probe": "node probes/render.mjs"
  },
  "dependencies": {
    "@acme/core": "file:../../.packs/acme-core-1.0.0.tgz",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "stunt-double": "file:../../.packs/stunt-double-0.1.0.tgz",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  },
  "packageManager": "yarn@4.18.1",
  "resolutions": {
    "@acme/core-slots": "file:../../.packs/acme-core-slots-0.0.1.tgz"
  }
}
