{
  "name": "customer-jest",
  "private": true,
  "version": "0.0.0",
  "description": "A project that injects its own components into @acme/core with stunt-double, tested with Jest 30 (babel-jest and @swc/jest, jsdom and node environments).",
  "type": "module",
  "scripts": {
    "postinstall": "stunt-double gen --no-fail",
    "test": "jest",
    "test:swc": "jest -c jest.swc.config.mjs",
    "typecheck": "tsc --noEmit",
    "check": "stunt-double check",
    "ci": "stunt-double check && jest"
  },
  "dependencies": {
    "@acme/core": "file:../../.packs/acme-core-1.0.0.tgz",
    "@acme/core-slots": "file:../../.packs/acme-core-slots-0.0.1.tgz",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@babel/core": "8.0.7",
    "@babel/preset-env": "8.0.7",
    "@babel/preset-react": "8.0.1",
    "@babel/preset-typescript": "8.0.7",
    "@jest/globals": "30.5.2",
    "@swc/core": "1.16.13",
    "@swc/jest": "0.2.39",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "babel-jest": "30.5.2",
    "jest": "30.5.2",
    "jest-environment-jsdom": "30.5.2",
    "stunt-double": "file:../../.packs/stunt-double-0.1.0.tgz",
    "typescript": "7.0.2"
  }
}
