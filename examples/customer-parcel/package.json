{
  "name": "customer-parcel",
  "private": true,
  "version": "0.0.0",
  "description": "A project that injects its own components and services into @acme/core with stunt-double (Parcel 2 browser app, resolver plugin).",
  "type": "module",
  "scripts": {
    "dev": "parcel serve index.html",
    "build": "parcel build",
    "probe": "node probes/render.mjs"
  },
  "targets": {
    "default": {
      "source": "index.html",
      "distDir": "dist"
    }
  },
  "@parcel/resolver-default": {
    "packageExports": true
  },
  "dependencies": {
    "@acme/core": "file:../../.packs/acme-core-1.0.0.tgz",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "parcel": "2.16.4",
    "playwright-core": "1.64.0",
    "stunt-double": "file:../../.packs/stunt-double-0.1.0.tgz",
    "typescript": "7.0.2"
  },
  "overrides": {
    "@acme/core-slots": "file:../../.packs/acme-core-slots-0.0.1.tgz"
  }
}
