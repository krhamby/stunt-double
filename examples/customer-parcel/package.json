{
  "name": "customer-parcel",
  "private": true,
  "version": "0.0.0",
  "description": "A project that injects its own components into @acme/core with stunt-double (Parcel 2.16).",
  "type": "module",
  "scripts": {
    "dev": "parcel serve --target app",
    "build": "parcel build",
    "check": "stunt-double check",
    "typecheck": "tsc -p tsconfig.json",
    "probe": "node probes/render.mjs",
    "probe:browser": "node probes/browser.mjs"
  },
  "targets": {
    "app": {
      "source": "index.html",
      "distDir": "dist"
    },
    "ssr": {
      "source": "src/entry-server.tsx",
      "context": "node",
      "outputFormat": "esmodule",
      "includeNodeModules": true,
      "isLibrary": true,
      "distDir": "dist-ssr"
    }
  },
  "@parcel/resolver-default": {
    "packageExports": true
  },
  "dependencies": {
    "@acme/core": "file:../../.packs/acme-core-1.0.0.tgz",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "parcel": "2.16.4",
    "stunt-double": "file:../../.packs/stunt-double-0.1.0.tgz",
    "typescript": "7.0.2"
  },
  "overrides": {
    "@acme/core-slots": "file:../../.packs/acme-core-slots-0.0.1.tgz"
  }
}
