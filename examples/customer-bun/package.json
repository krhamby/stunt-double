{
  "name": "customer-bun",
  "private": true,
  "version": "0.0.0",
  "description": "A project that injects its own components into @acme/core with stunt-double (Bun 1.4 bundler + bun test).",
  "type": "module",
  "workspaces": [
    "sdk-slots"
  ],
  "scripts": {
    "postinstall": "stunt-double gen --no-fail",
    "dev": "bun ./index.html",
    "build": "bun build.ts",
    "test": "stunt-double check && bun test",
    "typecheck": "tsc --noEmit",
    "check": "stunt-double check",
    "probe": "node probes/render.mjs"
  },
  "dependencies": {
    "@acme/core": "file:../../.packs/acme-core-1.0.0.tgz",
    "@acme/core-slots": "workspace:*",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "stunt-double": "file:../../.packs/stunt-double-0.1.0.tgz",
    "typescript": "7.0.2"
  }
}
