{
  "include": ["**/*", "**/.server/**/*", "**/.client/**/*", ".react-router/types/**/*"],
  "exclude": ["build", "node_modules"],
  "compilerOptions": {
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "types": ["node", "vite/client"],
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "rootDirs": [".", "./.react-router/types"],
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,

    /* stunt-double: types follow the generated shims, even inside node_modules/@acme/core */
    "paths": { "@acme/core-slots/*": ["./sdk-slots/gen/*"] }
  },
  /* stunt-double: a missing generated check file is TS6053, never "silently unchecked" */
  "files": ["app/stunt-double.check.ts"]
}
