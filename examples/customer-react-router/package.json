{
  "name": "customer-react-router",
  "private": true,
  "version": "0.0.0",
  "description": "React Router 8 framework mode (SSR) project that injects its own components into @acme/core with stunt-double.",
  "type": "module",
  "scripts": {
    "postinstall": "stunt-double gen --no-fail",
    "dev": "react-router dev",
    "build": "react-router build",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc",
    "check": "stunt-double check",
    "probe": "node probes/render.mjs"
  },
  "dependencies": {
    "@acme/core": "file:../../.packs/acme-core-1.0.0.tgz",
    "@acme/core-slots": "file:./sdk-slots",
    "@react-router/node": "8.4.0",
    "@react-router/serve": "8.4.0",
    "isbot": "5.2.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0"
  },
  "devDependencies": {
    "@react-router/dev": "8.4.0",
    "@types/node": "24.13.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "stunt-double": "file:../../.packs/stunt-double-0.1.0.tgz",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
