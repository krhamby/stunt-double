{
  "name": "customer-rspack",
  "private": true,
  "version": "0.0.0",
  "description": "A project that injects its own components into @acme/core with stunt-double (Rspack 2 + its dev server).",
  "type": "module",
  "scripts": {
    "postinstall": "stunt-double gen --no-fail",
    "dev": "rspack dev --mode development",
    "build": "rspack build --mode production",
    "typecheck": "tsc -p tsconfig.json",
    "check": "stunt-double check",
    "probe": "node probes/render.mjs dist-ssr/entry-server.mjs"
  },
  "dependencies": {
    "@acme/core": "file:../../.packs/acme-core-1.0.0.tgz",
    "@acme/core-slots": "file:./sdk-slots",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@rspack/cli": "2.2.8",
    "@rspack/core": "2.2.8",
    "@rspack/dev-server": "2.2.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "stunt-double": "file:../../.packs/stunt-double-0.1.0.tgz",
    "typescript": "7.0.2"
  }
}
