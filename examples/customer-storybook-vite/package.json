{
  "name": "customer-storybook-vite",
  "private": true,
  "version": "0.0.0",
  "description": "A project that injects its own components into @acme/core with stunt-double, documented in Storybook 10 on builder-vite (Vite 8).",
  "type": "module",
  "scripts": {
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o storybook-static",
    "build-storybook:vite-final": "storybook build -c .storybook-vite-final -o storybook-static-vite-final",
    "typecheck": "tsc -b",
    "probe": "node probes/render.mjs"
  },
  "dependencies": {
    "@acme/core": "file:../../.packs/acme-core-1.0.0.tgz",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@storybook/react-vite": "10.6.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "playwright-core": "1.56.1",
    "storybook": "10.6.1",
    "stunt-double": "file:../../.packs/stunt-double-0.1.0.tgz",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  },
  "overrides": {
    "@acme/core-slots": "file:../../.packs/acme-core-slots-0.0.1.tgz"
  }
}
