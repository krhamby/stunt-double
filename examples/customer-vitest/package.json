{
  "name": "customer-vitest",
  "private": true,
  "version": "0.0.0",
  "description": "A project that injects its own components into @acme/core with stunt-double, tested with Vitest 5: node and jsdom projects, a browser-mode config, and an unwired config that must fail.",
  "type": "module",
  "scripts": {
    "postinstall": "stunt-double gen --no-fail",
    "test": "vitest run",
    "test:browser": "vitest run -c vitest.browser.config.ts",
    "typecheck": "tsc -b",
    "check": "stunt-double check",
    "ci": "stunt-double check && vitest run"
  },
  "dependencies": {
    "@acme/core": "file:../../.packs/acme-core-1.0.0.tgz",
    "@acme/core-slots": "file:../../.packs/acme-core-slots-0.0.1.tgz",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/browser-playwright": "5.0.3",
    "jsdom": "30.1.2",
    "playwright": "1.64.0",
    "stunt-double": "file:../../.packs/stunt-double-0.1.0.tgz",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
